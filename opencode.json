{
  "$schema": "https://opencode.ai/config.json",
    "instructions": [
    "AGENTS.md",
    ".opencode/instructions/python-style.md",
    ".opencode/instructions/testing.md",
    ".opencode/instructions/project-conventions.md",
    ".opencode/instructions/libraries.md"
  ],
  "permission": {
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*": "allow"
    },
    "edit": "allow",
    "bash": {
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "*": "allow"
    },
    "task": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
