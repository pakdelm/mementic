{
  "$schema": "https://opencode.ai/config.json",
    "instructions": [
    "AGENTS.md",
    "docs/instructions/python-style.md",
    "docs/instructions/testing.md",
    "docs/instructions/project-conventions.md",
    "docs/instructions/libraries.md"
  ],
  "permission": {
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*": "allow"
    }
  },
  "mcp": {
    "mementic": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "mementic"],
      "enabled": true
    }
  }
}
